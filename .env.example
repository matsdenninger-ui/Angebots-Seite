# Kopieren nach .env und ausfüllen. Ohne .env läuft alles mit den Voreinstellungen.

# Port des Webservers
PORT=3000

# Wohin die Excel-Liste geschrieben wird.
# Voreinstellung: data/GWB_Nachunternehmerliste.xlsx
# Für ein Netzlaufwerk z. B.: EXCEL_DATEI=/mnt/gwb/Listen/GWB_Nachunternehmerliste.xlsx
# EXCEL_DATEI=
# DATEN_ORDNER=

# Wie viele Proxy-Ebenen vor dem Server stehen (nginx = 1). Wird für die
# Absenderkennung der Bremse gebraucht.
PROXY_EBENEN=1

# --- E-Mail (optional) ---------------------------------------------------
# Ohne SMTP_HOST wird keine Mail verschickt. Die Anfrage landet trotzdem in Excel.
# SMTP_HOST=smtp.ihr-anbieter.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_VON="GWB Partnerseite <noreply@gwb-wohnungsbau.de>"
# MAIL_AN=einkauf@gwb-wohnungsbau.de

# --- Wartung (optional) --------------------------------------------------
# Setzt diesen Wert, um POST /api/nachtragen freizuschalten. Damit lassen sich
# Anfragen nachtragen, die bei geoeffneter Excel-Datei liegen geblieben sind.
# WARTUNGS_SCHLUESSEL=
