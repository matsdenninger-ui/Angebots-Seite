{
  "name": "gwb-partneranfrage",
  "version": "1.0.0",
  "private": true,
  "description": "Landing Page fuer Nachunternehmer- und Lieferantenanfragen an die GWB Gewerbe- und Wohnungsbau GmbH. Anfragen werden automatisch in eine Excel-Liste geschrieben.",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "excel:rebuild": "node server/rebuild-excel.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
